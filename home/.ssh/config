## Terraform provisioned

Host tf-staging-*
    IdentitiesOnly yes
    IdentityFile ~/v2/terraform/keys/terraform-staging-us-west-1.pem
    User ec2-user
Host tf-preview-*
    IdentitiesOnly yes
    IdentityFile ~/v2/terraform/keys/terraform-preview-us-west-1.pem
    User ec2-user
Host tf-production-*
    IdentitiesOnly yes
    IdentityFile ~/v2/terraform/keys/terraform-production-eu-west-1.pem
    User ec2-user

Host tf-staging-* !tf-staging-bastion
    ProxyCommand ssh -q tf-staging-bastion nc %h %p
Host tf-preview-* !tf-preview-bastion
    ProxyCommand ssh -q tf-preview-bastion nc %h %p
Host tf-production-* !tf-production-bastion
    ProxyCommand ssh -q tf-production-bastion nc %h %p

Host tf-staging-bastion
    HostName ec2-52-53-191-237.us-west-1.compute.amazonaws.com
Host tf-preview-bastion
    HostName ec2-54-183-159-96.us-west-1.compute.amazonaws.com
Host tf-production-bastion
    HostName ec2-54-76-172-30.eu-west-1.compute.amazonaws.com

